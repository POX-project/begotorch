<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Flashlight & Hardware Controls -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_qs_torch_on"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Begotorch.Popup">

        <!-- Begoker Flashlight Quick Settings Tile -->
        <service
            android:name=".BegotorchTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_torch_off"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Accessibility Service for In-Shade Non-Collapsing Overlay -->
        <service
            android:name=".service.TorchAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            iOS Control Center Intensity Customization Popup.
            Triggered exclusively by long-pressing the Quick Settings tile
            via ACTION_QS_TILE_PREFERENCES.
            NOTE: LAUNCHER category is deliberately omitted so this remains purely
            a native system QS extension and does not clutter the app drawer.
        -->
        <activity
            android:name=".ui.TorchIntensityPopupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:theme="@style/Theme.Begotorch.Popup">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
